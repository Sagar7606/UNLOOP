{
  "manifest_version": 3,
  "name": "UNLOOP - Subscription Manager",
  "version": "1.0.0",
  "description": "Track and manage your subscriptions with UNLOOP.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5174/*",
    "https://unloop-tau.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UNLOOP"
  },
  "background": {
    "service_worker": "background.js"
  }
}